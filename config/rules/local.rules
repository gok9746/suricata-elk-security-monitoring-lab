# ====== Custom Suricata Rules for CA Lab ======

# 1. Web Brute Force
alert http any any -> $HOME_NET any (msg:"WEB Brute Force Detected"; flow:to_server,established; content:"username="; http_client_body; detection_filter:track by_src, count 10, seconds 30; sid:1000011; rev:1;)

# 2. SSH Brute Force
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; flags:S; detection_filter:track by_src, count 10, seconds 60; sid:1000012; rev:1;)

# 3. SQL Injection
alert http any any -> $HOME_NET any (msg:"SQL Injection Attempt Detected"; flow:to_server,established; content:"1=1"; http_uri; nocase; sid:1000013; rev:3;)

# 4. XSS Attempt
alert http any any -> $HOME_NET any (msg:"Cross Site Scripting (XSS) Attempt"; flow:to_server,established; content:"<script>"; nocase; http_client_body; sid:1000014; rev:1;)

# 5. Directory Traversal Attempt
alert http any any -> $HOME_NET any (msg:"Directory Traversal /etc/passwd"; flow:to_server,established; content:"/etc/passwd"; nocase; http_uri; sid:1000015; rev:1;)

# 6. ICMP Ping Sweep
alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Sweep Detected"; itype:8; detection_filter:track by_src, count 5, seconds 10; sid:1000017; rev:1;)

# 7. Nmap SYN Scan
alert tcp any any -> $HOME_NET any (msg:"Nmap SYN Scan Detected"; flags:S,12; detection_filter:track by_src, count 10, seconds 10; sid:1000018; rev:1;)

# 8. Access to phpMyAdmin
alert http any any -> $HOME_NET any (msg:"Attempt to Access phpMyAdmin"; flow:to_server,established; content:"phpmyadmin"; http_uri; nocase; sid:1000019; rev:1;)

# 9. Access to wp-login.php
alert http any any -> $HOME_NET any (msg:"Attempt to Access wp-login.php"; flow:to_server,established; content:"wp-login.php"; http_uri; nocase; sid:1000020; rev:1;)

# 10. Suspicious User-Agent (sqlmap)
alert http any any -> $HOME_NET any (msg:"Suspicious User-Agent (sqlmap)"; content:"User-Agent|3a| sqlmap"; http_header; nocase; sid:1000021; rev:1;)

# 11. Juice Shop Detection
alert http any any -> $HOME_NET 3000 (msg:"Juice Shop Access Detected on Port 3000"; flow:to_server,established; sid:1000022; rev:1;)
